  },
  "maximum_lines": 2,
  "font": "Segoe UI44px",
  "maximum_measured_line_width_px": 1560,
  "short_orphan_groups_merged": 11,
  "old_group_count": 142,
  "new_group_count": 131,
  "spoken_words": 1267,
  "trailing_connector_words_moved_to_next_cue": 19,
