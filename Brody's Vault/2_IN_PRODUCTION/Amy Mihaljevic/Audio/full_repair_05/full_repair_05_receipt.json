      "before_source_end_sample_exclusive": 13745970,
      "before_source_start_seconds": 282.62,
      "before_source_end_seconds": 311.7,
      "after_paced_start_sample": 11900666,
      "after_paced_end_sample_exclusive": 13158837,
      "after_paced_start_seconds": 269.8563718820862,
      "after_paced_end_seconds": 298.3863265306122,
      "before_duration_seconds": 29.08,
      "after_duration_seconds": 28.529954648526076,
      "before": {
        "path": "C:\\Youtube Automation Obsidian\\Brody's Vault\\2_IN_PRODUCTION\\Amy Mihaljevic\\Audio\\full_repair_05\\middle_paragraph_before.mp3",
        "bytes": 699707,
        "sha256": "b0ef1e7631adb19daf873266d9fbec2c53e21ae65e00f72700a2ad4fd4b6882e"
      },
      "after": {
        "path": "C:\\Youtube Automation Obsidian\\Brody's Vault\\2_IN_PRODUCTION\\Amy Mihaljevic\\Audio\\full_repair_05\\middle_paragraph_after_pacing.mp3",
        "bytes": 686542,
        "sha256": "7e13d61885b08b7245933d2207f4511b416e1a0cf7c4037548b709089f5aea40"
      },
      "same_baseline_gain": true,
      "note": "Before is correction03 source, after includes exact diagnostic04 repair where applicable plus proposed pacing; no new global gain."
    },
    {
      "label": "end",
      "paragraph_id": 17,
      "complete_approved_paragraph_text": "By June, Police Chief Robert Gillespie was describing the resources needed to keep testing evidence. He told Cleveland 19 that work was continuing, although he could not discuss every item being tested. He explained that the Amy Fund supplemented other funding so investigators could respond when testing opportunities arose. Bay Village's own community announcement also describes the fund as supporting investigative costs, including DNA testing. Financial support helps that work continue; it is not a test result.",
