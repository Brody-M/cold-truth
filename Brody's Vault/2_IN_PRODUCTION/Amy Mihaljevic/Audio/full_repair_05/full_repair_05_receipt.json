  "actual_paragraph_comparisons": [
    {
      "label": "opening",
      "paragraph_id": 1,
      "complete_approved_paragraph_text": "On the afternoon Amy Mihaljevic disappeared, her mother received a phone call from her. An FBI account describes Amy saying she was okay. Her mother believed she was calling from home. According to FBI Special Agent Vicki Anderson, Amy was already with the person who had taken her. A familiar kind of check-in had given her mother a mistaken picture of where her daughter was.",
      "before_source_start_sample": 0,
      "before_source_end_sample_exclusive": 1175265,
      "before_source_start_seconds": 0.0,
      "before_source_end_seconds": 26.65,
      "after_paced_start_sample": 0,
      "after_paced_end_sample_exclusive": 1116167,
      "after_paced_start_seconds": 0.0,
      "after_paced_end_seconds": 25.309909297052155,
      "before_duration_seconds": 26.65,
      "after_duration_seconds": 25.309909297052155,
      "before": {
        "path": "C:\\Youtube Automation Obsidian\\Brody's Vault\\2_IN_PRODUCTION\\Amy Mihaljevic\\Audio\\full_repair_05\\opening_paragraph_before.mp3",
        "bytes": 641402,
        "sha256": "132e4cce9a4e046dbe06350c35d6532a7503cd4cbfa660be2530213eb392a495"
      },
      "after": {
        "path": "C:\\Youtube Automation Obsidian\\Brody's Vault\\2_IN_PRODUCTION\\Amy Mihaljevic\\Audio\\full_repair_05\\opening_paragraph_after_pacing.mp3",
        "bytes": 608801,
        "sha256": "2cdd445a334f3ee65748f2794d55e67d731f6d075b02e1b71f3946e78b953bb3"
      },
      "same_baseline_gain": true,
      "note": "Before is correction03 source, after includes exact diagnostic04 repair where applicable plus proposed pacing; no new global gain."
    },
    {
      "label": "middle",
      "paragraph_id": 11,
      "complete_approved_paragraph_text": "The release brought responses. Cleveland 19 reported that the prosecutor's office received calls and tips afterward, and that law enforcement was following them up. The curtain offered a possible connection between a physical object and information someone outside the investigation might hold. Its owner and origin were still questions; the public release did not announce that either had been established.",
