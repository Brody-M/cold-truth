  "segments": [
    {
      "start": 0.08,
      "end": 3.962,
      "text": "Two testing reports in Amy\nMihaljevic’s case concerned"
    },
    {
      "start": 4.022,
      "end": 7.784,
      "text": "different evidence. Amy was\nten when she was abducted"
    },
    {
      "start": 7.924,
      "end": 9.605,
      "text": "in Ohio in 1989."
    },
    {
      "start": 10.465,
      "end": 15.028,
      "text": "In 2024, police said retesting\nher clothing detected male"
    },
    {
      "start": 15.088,
      "end": 17.789,
      "text": "DNA, but too little to create a\nprofile."
    },
    {
      "start": 18.669,
      "end": 20.35,
      "text": "That did not identify a\nperson."
    },
    {
      "start": 21.211,
      "end": 24.272,
      "text": "Separate hairs were sent for\ntesting in California."
    },
    {
      "start": 25.253,
      "end": 29.915,
      "text": "In January 2026, Cleveland 19\nreported that Astrea"
    },
    {
      "start": 29.955,
      "end": 33.537,
      "text": "Forensics could not obtain a\nprofile from those hairs,"
    },
    {
      "start": 34.137,
      "end": 37.139,
      "text": "according to Detective\nSergeant Jay Elish."
    },
    {
      "start": 37.159,
      "end": 39.04,
      "text": "That outcome concerned the\nhairs."
    },
    {
      "start": 39.96,
      "end": 42.942,
      "text": "It did not erase the separate\nclothing-DNA finding."
    },
    {
      "start": 43.882,
      "end": 46.163,
      "text": "Investigators were continuing\nDNA work;"
    },
    {
      "start": 46.944,
      "end": 49.085,
      "text": "neither report announced an\nidentification."
    }
  ],
