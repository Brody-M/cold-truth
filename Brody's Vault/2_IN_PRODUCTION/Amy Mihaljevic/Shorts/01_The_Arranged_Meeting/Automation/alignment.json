  "segments": [
    {
      "start": 0.08,
      "end": 3.242,
      "text": "A gift for her mother was the\nexplanation Amy Mihaljevic"
    },
    {
      "start": 3.302,
      "end": 6.383,
      "text": "was given for an after-school\nmeeting."
    },
    {
      "start": 6.403,
      "end": 7.144,
      "text": "Amy was ten."
    },
    {
      "start": 8.084,
      "end": 12.506,
      "text": "Before she disappeared on\nOctober 27, 1989, a"
    },
    {
      "start": 12.586,
      "end": 15.568,
      "text": "caller had contacted her\nabout celebrating her"
    },
    {
      "start": 15.628,
      "end": 19.67,
      "text": "mother’s promotion. Bay\nVillage Police say that contact"
    },
    {
      "start": 19.71,
      "end": 20.91,
      "text": "happened weeks earlier."
    },
    {
      "start": 21.651,
      "end": 24.932,
      "text": "The FBI says Amy walked\nfrom school to Bay Village"
    },
    {
      "start": 24.972,
      "end": 28.354,
      "text": "Square in Ohio, where she\nwas seen apparently waiting"
    },
    {
      "start": 28.454,
      "end": 29.335,
      "text": "outside a business."
    },
    {
      "start": 30.315,
      "end": 33.457,
      "text": "Police describe witnesses\nseeing her speak with an"
    },
    {
      "start": 33.617,
      "end": 36.698,
      "text": "unidentified man and walk\nthrough the parking lot with"
    },
    {
      "start": 36.758,
      "end": 40.14,
      "text": "him. No vehicle was seen,\naccording to police."
    },
    {
      "start": 41.261,
      "end": 43.782,
      "text": "That sighting does not\nestablish where Amy went"
    },
    {
      "start": 43.822,
      "end": 44.102,
      "text": "next."
    }
  ],
