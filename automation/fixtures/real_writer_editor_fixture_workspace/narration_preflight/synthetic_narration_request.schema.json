{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "request_id", "case_id", "requested_action", "requested_output_relative_path", "requested_output_format", "write_fake_artifact", "invoke_actual_narration", "invoke_provider", "network_requested", "asset_authorized", "assembly_authorized", "rendering_authorized", "upload_authorized", "scheduling_authorized", "publishing_enabled", "real_production_enabled"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"},
    "case_id": {"type": "string", "enum": ["glass-river-writing-fixture"]},
    "requested_action": {"type": "string", "enum": ["synthetic_narration_generation_only"]},
    "requested_output_relative_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*\\.mp3$"},
    "requested_output_format": {"type": "string", "enum": ["mp3_44100_128"]},
    "write_fake_artifact": {"type": "boolean"},
    "invoke_actual_narration": {"type": "boolean", "enum": [false]},
    "invoke_provider": {"type": "boolean", "enum": [false]},
    "network_requested": {"type": "boolean", "enum": [false]},
    "asset_authorized": {"type": "boolean", "enum": [false]},
    "assembly_authorized": {"type": "boolean", "enum": [false]},
    "rendering_authorized": {"type": "boolean", "enum": [false]},
    "upload_authorized": {"type": "boolean", "enum": [false]},
    "scheduling_authorized": {"type": "boolean", "enum": [false]},
    "publishing_enabled": {"type": "boolean", "enum": [false]},
    "real_production_enabled": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
