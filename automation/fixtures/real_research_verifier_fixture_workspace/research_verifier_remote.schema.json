{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "contract_id", "contract_version", "run_id", "case_id", "stage", "attempt", "idempotency_key", "status", "started_at", "completed_at", "inputs", "outputs", "result", "decisions", "warnings", "errors", "retryable", "tool_calls", "runtime", "publishing_enabled", "real_production_enabled"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "contract_id": {"type": "string", "enum": ["cold-truth.research-verifier"]},
    "contract_version": {"type": "string", "enum": ["1.0.0-c2-fixture"]},
    "run_id": {"type": "string", "enum": ["phase-c2-research-verifier-fixture"]},
    "case_id": {"type": "string", "enum": ["glass-river-research-fixture"]},
    "stage": {"type": "string", "enum": ["research_verification_fixture"]},
    "attempt": {"type": "integer", "enum": [1]},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["success"]},
    "started_at": {"type": "string", "enum": ["2026-07-11T00:00:00Z"]},
    "completed_at": {"type": "string", "enum": ["2026-07-11T00:00:00Z"]},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "kind", "path", "sha256", "size_bytes"],
        "properties": {
          "name": {"type": "string", "enum": ["synthetic_research_boundaries", "synthetic_source_ledger", "synthetic_strategist_handoff"]},
          "type": {"type": "string", "enum": ["synthetic_research_boundaries", "synthetic_source_ledger", "synthetic_strategist_handoff"]},
          "kind": {"type": "string", "enum": ["file"]},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "outputs": {"type": "array", "items": {"type": "object", "required": [], "properties": {}, "additionalProperties": false}},
    "result": {
      "type": "object",
      "required": ["upstream_strategist_handoff_hash", "ledger_hash", "boundaries_hash", "approved_claim_1", "approved_claim_2", "approved_claim_3", "rejected_claim_1", "rejected_reason_1", "rejected_claim_2", "rejected_reason_2", "rejected_claim_3", "rejected_reason_3", "source_conflicts", "unsupported_or_creator_derived_material", "verification_status", "proceed_to_writer", "required_human_escalation", "artifact_hashes", "external_research_performed", "browser_used", "mcp_used", "network_used"],
      "properties": {
        "upstream_strategist_handoff_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ledger_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "boundaries_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_claim_1": {"type": "string", "enum": ["SYN-RV-01"]},
        "approved_claim_2": {"type": "string", "enum": ["SYN-RV-02"]},
        "approved_claim_3": {"type": "string", "enum": ["SYN-RV-03"]},
        "rejected_claim_1": {"type": "string", "enum": ["SYN-RV-X1"]},
        "rejected_reason_1": {"type": "string", "enum": ["unverified_unnamed_allegation"]},
        "rejected_claim_2": {"type": "string", "enum": ["SYN-RV-X2"]},
        "rejected_reason_2": {"type": "string", "enum": ["unverified_online_theory"]},
        "rejected_claim_3": {"type": "string", "enum": ["SYN-RV-X3"]},
        "rejected_reason_3": {"type": "string", "enum": ["source_ledger_conflict"]},
        "source_conflicts": {"type": "array", "items": {"type": "string"}},
        "unsupported_or_creator_derived_material": {"type": "array", "items": {"type": "string"}},
        "verification_status": {"type": "string", "enum": ["approved_with_exclusions"]},
        "proceed_to_writer": {"type": "boolean", "enum": [true]},
        "required_human_escalation": {"type": "boolean", "enum": [false]},
        "artifact_hashes": {"type": "object", "required": [], "properties": {}, "additionalProperties": false},
        "external_research_performed": {"type": "boolean", "enum": [false]},
        "browser_used": {"type": "boolean", "enum": [false]},
        "mcp_used": {"type": "boolean", "enum": [false]},
        "network_used": {"type": "boolean", "enum": [false]}
      },
      "additionalProperties": false
    },
    "decisions": {"type": "array", "items": {"type": "object", "required": ["rule", "result"], "properties": {"rule": {"type": "string", "enum": ["synthetic_fixture_only"]}, "result": {"type": "string", "enum": ["pass"]}}, "additionalProperties": false}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "retryable": {"type": "boolean", "enum": [false]},
    "tool_calls": {"type": "array", "items": {"type": "object", "required": [], "properties": {}, "additionalProperties": false}},
    "runtime": {"type": "object", "required": ["provider", "runtime", "model", "version"], "properties": {"provider": {"type": "string", "enum": ["codex-exec"]}, "runtime": {"type": "string", "enum": ["controlled-real-fixture"]}, "model": {"type": "string", "enum": ["not-reported"]}, "version": {"type": "string", "enum": ["not-reported"]}}, "additionalProperties": false},
    "publishing_enabled": {"type": "boolean", "enum": [false]},
    "real_production_enabled": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
