{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "contract_id", "contract_version", "run_id", "case_id", "stage", "attempt", "idempotency_key", "status", "started_at", "completed_at", "inputs", "outputs", "result", "decisions", "warnings", "errors", "retryable", "tool_calls", "runtime", "publishing_enabled", "real_production_enabled"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "contract_id": {"type": "string", "enum": ["cold-truth.research-verifier"]},
    "contract_version": {"type": "string", "enum": ["1.0.0-c2-fixture"]},
    "run_id": {"type": "string", "enum": ["phase-c2-research-verifier-fixture"]},
    "case_id": {"type": "string", "enum": ["glass-river-research-fixture"]},
    "stage": {"type": "string", "enum": ["research_verification_fixture"]},
    "attempt": {"type": "integer", "enum": [1]},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["success"]},
    "started_at": {"type": "string", "enum": ["2026-07-11T00:00:00Z"]},
    "completed_at": {"type": "string", "enum": ["2026-07-11T00:00:00Z"]},
    "inputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["name", "type", "kind", "path", "sha256", "size_bytes"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "kind": {"type": "string", "enum": ["file"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer"}}, "additionalProperties": false}},
    "outputs": {"type": "array", "maxItems": 0, "items": {"type": "object", "required": [], "properties": {}, "additionalProperties": false}},
    "result": {
      "type": "object",
      "required": ["upstream_strategist_handoff_hash", "ledger_hash", "boundaries_hash", "approved_claim_ids", "rejected_claims", "source_conflicts", "unsupported_or_creator_derived_material", "verification_status", "proceed_to_writer", "required_human_escalation", "artifact_hashes", "external_research_performed", "browser_used", "mcp_used", "network_used"],
      "properties": {
        "upstream_strategist_handoff_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ledger_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "boundaries_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_claim_ids": {"type": "array", "const": ["SYN-RV-01", "SYN-RV-02", "SYN-RV-03"], "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "rejected_claims": {"type": "array", "const": [{"claim_id": "SYN-RV-X1", "reason_code": "unverified_unnamed_allegation"}, {"claim_id": "SYN-RV-X2", "reason_code": "unverified_online_theory"}, {"claim_id": "SYN-RV-X3", "reason_code": "source_ledger_conflict"}], "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["claim_id", "reason_code"], "properties": {"claim_id": {"type": "string"}, "reason_code": {"type": "string"}}, "additionalProperties": false}},
        "source_conflicts": {"type": "array", "const": ["SYN-RV-X3: source_ledger_conflict"], "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "unsupported_or_creator_derived_material": {"type": "array", "const": ["SYN-RV-X1", "SYN-RV-X2"], "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "verification_status": {"type": "string", "enum": ["approved_with_exclusions"]},
        "proceed_to_writer": {"type": "boolean", "enum": [true]},
        "required_human_escalation": {"type": "boolean", "enum": [false]},
        "artifact_hashes": {"type": "object", "required": [], "properties": {}, "additionalProperties": false},
        "external_research_performed": {"type": "boolean", "enum": [false]},
        "browser_used": {"type": "boolean", "enum": [false]},
        "mcp_used": {"type": "boolean", "enum": [false]},
        "network_used": {"type": "boolean", "enum": [false]}
      },
      "additionalProperties": false
    },
    "decisions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["rule", "result"], "properties": {"rule": {"type": "string", "enum": ["synthetic_fixture_only"]}, "result": {"type": "string", "enum": ["pass"]}}, "additionalProperties": false}},
    "warnings": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "errors": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "retryable": {"type": "boolean", "enum": [false]},
    "tool_calls": {"type": "array", "maxItems": 0, "items": {"type": "object", "required": [], "properties": {}, "additionalProperties": false}},
    "runtime": {"type": "object", "required": ["provider", "runtime", "model", "version"], "properties": {"provider": {"type": "string", "enum": ["codex-exec"]}, "runtime": {"type": "string", "enum": ["controlled-real-fixture"]}, "model": {"type": "string", "enum": ["not-reported"]}, "version": {"type": "string", "enum": ["not-reported"]}}, "additionalProperties": false},
    "publishing_enabled": {"type": "boolean", "enum": [false]},
    "real_production_enabled": {"type": "boolean", "enum": [false]}
  },
  "additionalProperties": false
}
