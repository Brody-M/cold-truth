{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cold-truth-asset-manifest.schema.json",
  "title": "Cold Truth isolated visual-track asset manifest",
  "type": "object",
  "required": ["schema_version", "track", "shared_assets_allowed", "synthetic", "media_created", "assets"],
  "properties": {
    "schema_version": {"const": "cold_truth.asset_manifest.v1"},
    "track": {"enum": ["youtube-longform", "shorts"]},
    "shared_assets_allowed": {"const": false},
    "synthetic": {"const": true},
    "media_created": {"const": false},
    "assets": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
