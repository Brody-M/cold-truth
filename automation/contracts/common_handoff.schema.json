{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cold-truth-common-handoff.schema.json",
  "title": "Cold Truth common agent handoff",
  "type": "object",
  "required": [
    "schema_version", "contract_id", "contract_version", "run_id", "case_id", "episode_id",
    "stage", "attempt", "idempotency_key", "provider_id", "status", "started_at", "completed_at",
    "inputs", "outputs", "result", "decisions", "warnings", "errors", "retryable",
    "tool_calls", "runtime", "publishing_enabled"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "failure", "blocked"]},
    "publishing_enabled": {"const": false},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "result": {"type": "object"},
    "tool_calls": {"type": "array"},
    "retryable": {"type": "boolean"}
  },
  "additionalProperties": false
}
