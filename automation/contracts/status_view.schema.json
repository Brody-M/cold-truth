{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cold-truth-run-status.schema.json",
  "title": "Cold Truth canonical run status",
  "type": "object",
  "required": [
    "schema_version", "run_id", "episode_id", "case", "current_checkpoint",
    "terminal_or_human_review_state", "dry_run", "blocker",
    "last_clean_artifact", "active_artifact_count", "stale_artifacts",
    "stale_artifact_count", "stale_record_count", "approvals", "audit_chain",
    "next_permitted_action", "capabilities", "status_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cold_truth.run_status.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "case": {"type": "object"},
    "current_checkpoint": {"type": "string", "minLength": 1},
    "terminal_or_human_review_state": {"type": "boolean"},
    "dry_run": {"const": true},
    "blocker": {"type": ["object", "null"]},
    "last_clean_artifact": {"type": ["object", "null"]},
    "active_artifact_count": {"type": "integer", "minimum": 0},
    "stale_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stale_artifact_count": {"type": "integer", "minimum": 0},
    "stale_record_count": {"type": "integer", "minimum": 0},
    "approvals": {"type": "object"},
    "audit_chain": {"type": ["object", "null"]},
    "next_permitted_action": {
      "type": "object",
      "required": ["action", "human_authority_required", "offline_only", "maximum_action_count"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "human_authority_required": {"type": "boolean"},
        "offline_only": {"const": true},
        "maximum_action_count": {"const": 1}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "network_enabled": {"const": false},
        "provider_enabled": {"const": false},
        "media_creation_enabled": {"const": false},
        "rendering_enabled": {"const": false},
        "upload_enabled": {"const": false},
        "scheduling_enabled": {"const": false},
        "publishing_enabled": {"const": false},
        "real_production_enabled": {"const": false}
      },
      "additionalProperties": false
    },
    "status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
